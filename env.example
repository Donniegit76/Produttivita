# Fast_Prod - variabili d'ambiente
# Copiare questo file in ".env" (nella stessa cartella) e modificare le password.
# Il file ".env" NON deve mai finire in git (è già in .gitignore).

# Password di accesso admin (inserisce e modifica i dati)
ADMIN_PASSWORD=cambiami-admin

# Password condivisa per gli utenti in sola lettura
VIEWER_PASSWORD=cambiami-viewer

# Segreto per firmare i cookie di sessione: generare una stringa casuale lunga
SESSION_SECRET=cambiami-con-una-stringa-casuale-lunga

# Porta interna del container (la porta esterna è definita in docker-compose.yml)
PORT=8080

# Fuso orario usato per settimane, date e backup giornaliero
TZ=Europe/Rome

# Giorni di retention dei backup automatici
BACKUP_RETENTION_DAYS=30
